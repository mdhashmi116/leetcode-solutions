class Solution {
    public int smallestIndex(int[] nums) {
        int encounter=-1;

        for(int i=0;i<nums.length;i++){
    int sum=0,r=0;
            while(nums[i]>0){
                r=nums[i]%10;
                nums[i]=nums[i]/10;
                sum=sum+r;
            }
            if(sum==i){
                encounter=i;
                break;
            }
        }
        if(encounter==-1)return -1;
        return encounter;
    }
}
